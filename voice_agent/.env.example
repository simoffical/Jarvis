# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- LiveKit project (Cloud or self-hosted) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Providers ---
# STT
DEEPGRAM_API_KEY=
# TTS -- note the plugin reads ELEVEN_API_KEY, not ELEVENLABS_API_KEY
ELEVEN_API_KEY=
# LLM
ANTHROPIC_API_KEY=

# --- Jarvis-specific ---
# The ONLY participant identity this agent will treat as the authenticated
# user. Set this to the identity you put in the access token your client
# app issues for yourself (see README.md). The agent blocks on
# wait_for_participant(identity=...) for exactly this identity -- anyone
# else joining the room is never treated as "user" for approval purposes.
JARVIS_AUTHORIZED_IDENTITY=

# Optional overrides
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2   # Alice - Clear, Engaging Educator (default)
# JARVIS_LLM_MODEL=claude-sonnet-4-6
